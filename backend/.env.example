# Server
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
APP_URL=http://localhost:5173

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://unicts:unicts@localhost:5433/unicts?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
FILE_SIGNING_SECRET=change-me-file-secret

# Redis — optional in dev; background jobs run inline when unset
# REDIS_URL=redis://localhost:6380

# OTP
OTP_TTL_MINUTES=10
# When true (dev only), OTP codes are logged to the server console and echoed
# in API responses so the flow can be exercised without an SMS/email provider.
OTP_DEV_ECHO=true

# Object storage — optional; falls back to local ./uploads with HMAC-signed URLs
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=unicts
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Email — optional; messages are logged to console when unset
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="UNICTS <no-reply@unicts.org.np>"

# SMS — Sparrow SMS v2 (https://github.com/sparrowsms/apidocs); messages are
# logged to the console when unset. SMS_FROM must be the identity Sparrow
# assigned to your account; SMS_TOKEN comes from their dashboard.
# SMS_API_URL=https://api.sparrowsms.com/v2/sms/
# SMS_TOKEN=
# SMS_FROM=UNICTS

# Google Calendar OAuth2 — optional
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/members/me/calendar/callback

# PDF rendering — puppeteer-core drives your installed Chrome; override path if needed
# PUPPETEER_EXECUTABLE_PATH=
